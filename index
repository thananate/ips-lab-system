    function openApprovalModal(docId) {
      activeApprovalDocId = docId;
      const req = STATE.requests.find(r => r.docId === docId);
      document.getElementById('appModalMeta').innerText = `${req.id} | ${req.teacherName} | ${req.lab} Lab | วันที่ ${req.useDate} (${req.startTime}-${req.endTime})`;
      document.getElementById('appStaffRemarks').value = req.staffRemarks || '';

      const html = (req.items || []).map((it, idx) => {
        const slotAvail = getAvailableForTimeSlot(it.eqDocId, req.useDate, req.startTime, req.endTime, req.id);
        const suggestedQty = Math.min(it.requestedQty, slotAvail);
        return `
          <div class="p-3.5 rounded-xl border border-slate-200 bg-slate-50/70 space-y-2">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <span class="font-bold text-slate-800 text-sm">${it.name}</span>
                <span class="text-xs text-slate-500 ml-2">ขอเบิก: <b>${it.requestedQty}</b> | ว่างในช่วงเวลานี้: <b class="${slotAvail < it.requestedQty ? 'text-rose-600' : 'text-emerald-600'}">${slotAvail}</b></span>
              </div>
              <div class="flex items-center gap-2">
                <select id="itemAct_${idx}" onchange="handleItemActionChange(${idx}, ${suggestedQty})" class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs bg-white">
                  <option value="Approved" ${slotAvail >= it.requestedQty ? 'selected' : ''}>Approve (อนุมัติ)</option>
                  <option value="Partial" ${slotAvail > 0 && slotAvail < it.requestedQty ? 'selected' : ''}>Partial Approval (อนุมัติบางส่วน)</option>
                  <option value="Rejected" ${slotAvail === 0 ? 'selected' : ''}>Reject (ไม่อนุมัติ/ของหมด)</option>
                  <option value="Alternative">Alternative (เสนออุปกรณ์ทดแทน)</option>
                </select>
                <input type="number" id="itemQty_${idx}" min="0" max="${slotAvail}" value="${suggestedQty}" class="w-20 px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs bg-white" />
              </div>
            </div>
            <input type="text" id="itemAlt_${idx}" value="${it.alternativeNote || ''}" placeholder="ระบุอุปกรณ์ทดแทนหรือเหตุผล (ถ้ามี)..." class="w-full px-3 py-1.5 rounded-lg border border-slate-200 text-xs bg-white" />
          </div>
        `;
      }).join('');

      document.getElementById('approvalItemsContainer').innerHTML = html;
      const modal = document.getElementById('approvalModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function handleItemActionChange(idx, suggestedQty) {
      const act = document.getElementById(`itemAct_${idx}`).value;
      const qtyInput = document.getElementById(`itemQty_${idx}`);
      if (act === 'Rejected' || act === 'Alternative') qtyInput.value = 0;
      else qtyInput.value = suggestedQty;
    }

    async function submitStaffApproval() {
      const req = STATE.requests.find(r => r.docId === activeApprovalDocId);
      const updatedItems = JSON.parse(JSON.stringify(req.items || []));
      let anyApproved = false;
      let allApproved = true;

      for (let idx = 0; idx < updatedItems.length; idx++) {
        const it = updatedItems[idx];
        const act = document.getElementById(`itemAct_${idx}`).value;
        const appQty = Number(document.getElementById(`itemQty_${idx}`).value);
        const altNote = document.getElementById(`itemAlt_${idx}`).value.trim();

        const slotAvail = getAvailableForTimeSlot(it.eqDocId, req.useDate, req.startTime, req.endTime, req.id);
        if (appQty > slotAvail) {
          return Swal.fire('ป้องกันการจองซ้ำซ้อน', `อุปกรณ์ ${it.name} มีจำนวนว่างในช่วงเวลานี้สูงสุด ${slotAvail} ชิ้น ไม่สามารถอนุมัติเกินได้`, 'error');
        }

        const eq = STATE.equipments.find(e => e.id === it.eqDocId);
        let curTotal = Number(eq.total || 0);
        let curAvail = Number(eq.available || 0);
        let curRes = Number(eq.reserved || 0);

        if (it.approvedQty > 0 && eq) {
          if (eq.type === 'Consumable' || eq.type === 'Chemical') {
            curTotal += Number(it.approvedQty);
            curAvail += Number(it.approvedQty);
          } else {
            curRes = Math.max(0, curRes - Number(it.approvedQty));
            curAvail += Number(it.approvedQty);
          }
        }

        it.itemStatus = act;
        it.approvedQty = appQty;
        it.alternativeNote = altNote;

        if (appQty > 0 && eq) {
          anyApproved = true;
          if (appQty < it.requestedQty) allApproved = false;

          if (eq.type === 'Consumable' || eq.type === 'Chemical') {
            curTotal -= appQty;
            curAvail -= appQty;
            await db.collection('equipments').doc(eq.id).update({ total: curTotal, available: curAvail });
            await addStockMovement(eq.equipmentId, eq.name, eq.lab, 'Stock Out', -appQty, `เบิกใช้สิ้นเปลืองตามคำขอ ${req.id}`);
          } else {
            curRes += appQty;
            curAvail = Math.max(0, curAvail - appQty);
            await db.collection('equipments').doc(eq.id).update({ reserved: curRes, available: curAvail });
            await addStockMovement(eq.equipmentId, eq.name, eq.lab, 'Reserved', -appQty, `อนุมัติจองตามคำขอ ${req.id}`);
          }
        } else {
          allApproved = false;
        }
      }

      const finalStatus = !anyApproved ? 'Rejected' : (allApproved ? 'Approved' : 'Partial');
      await db.collection('requests').doc(req.docId).update({
        items: updatedItems,
        status: finalStatus,
        approvedBy: STATE.currentUser.name,
        approvalDate: new Date().toISOString().slice(0, 16).replace('T', ' '),
        staffRemarks: document.getElementById('appStaffRemarks').value.trim()
      });

      closeModal('approvalModal');
      Swal.fire('บันทึกการอนุมัติสำเร็จ', `สถานะคำขอ ${req.id}: ${finalStatus}`, 'success');
    }


    async function updateUserRole(uid, role) {
      await db.collection('user').doc(uid).update({ role });
      Swal.fire('บันทึกสำเร็จ', 'อัปเดตสิทธิ์ผู้ใช้งานใน Firestore เรียบร้อยแล้ว', 'success');
    }

    async function toggleUserLabField(uid, labName, isChecked) {
      await db.collection('user').doc(uid).update({ [labName]: isChecked });
      Swal.fire('บันทึกสำเร็จ', `อัปเดตสิทธิ์ห้อง ${labName} Lab เรียบร้อยแล้ว`, 'success');
    }

    // =========================================================================
    // 14. HELPERS & INIT
    // =========================================================================
    function getStatusBadge(status) {
      const map = {
        'Pending': 'bg-amber-100 text-amber-700',
        'Approved': 'bg-emerald-100 text-emerald-700',
        'Partial': 'bg-blue-100 text-blue-700',
        'Rejected': 'bg-rose-100 text-rose-700',
        'Cancelled': 'bg-slate-200 text-slate-600',
        'Returned': 'bg-indigo-100 text-indigo-700'
      };
      return map[status] || 'bg-slate-100 text-slate-700';
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    lucide.createIcons();
  </script>

            <h4 class="font-bold text-sm text-slate-800 mb-3">รายงาน: ${currentReportType} (${currentReportLab === 'All' ? 'ทุกห้อง Lab' : currentReportLab + ' Lab'})</h4>
            ${rows.length === 0 ? '<p class="text-xs text-slate-400 py-6 text-center">ไม่พบข้อมูลตามเงื่อนไขที่เลือก</p>' : `

    // Helper: ดึงรายชื่อ Lab ที่ User มีสิทธิ์ดูแล
    function getUserAllowedLabs(user) {
      if (!user) return [];
      if (['Super Admin', 'Admin', 'Teacher'].includes(user.role)) {

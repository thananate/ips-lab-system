      };

      try {
        if (docId) {
          const old = STATE.equipments.find(x => x.id === docId);
          const diff = total - Number(old.total || 0);
          await db.collection('equipments').doc(docId).update({
            ...payload,
            available: Math.max(0, Number(old.available || 0) + diff)

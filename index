        document.getElementById('prLab').value = prefill.lab;
        document.getElementById('prQty').value = Math.max(1, Number(prefill.minStock) - Number(prefill.available) + 5);
        document.getElementById('prUnit').value = prefill.unit;
        document.getElementById('prReason').value = `Low Stock (คงเหลือ ${prefill.available} / ขั้นต่ำ ${prefill.minStock})`;
      }
      const modal = document.getElementById('purchaseModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }


        requestDate: new Date().toISOString().slice(0, 10),
        status: 'Pending',
        receivedDate: ''
      });
      closeModal('purchaseModal');
      Swal.fire('บันทึกสำเร็จ', 'สร้างคำขอจัดซื้อเรียบร้อยแล้ว', 'success');

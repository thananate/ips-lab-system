    async function updatePurchaseStatus(docId, newStatus) {
      const pr = STATE.purchases.find(p => p.docId === docId);
      const updateData = { status: newStatus };
      if (newStatus === 'Received' && pr.status !== 'Received') {
        updateData.receivedDate = new Date().toISOString().slice(0, 10);
        const eq = STATE.equipments.find(e => e.name.toLowerCase() === pr.equipmentName.toLowerCase() && e.lab === pr.lab);
        if (eq) {
          await db.collection('equipments').doc(eq.id).update({
            total: Number(eq.total) + Number(pr.qty),
            available: Number(eq.available) + Number(pr.qty)
          });
          await addStockMovement(eq.equipmentId, eq.name, eq.lab, 'Stock In', pr.qty, `รับเข้าจากการจัดซื้อ ${pr.id}`);
        }
      }
      await db.collection('purchases').doc(docId).update(updateData);
      Swal.fire('อัปเดตสถานะแล้ว', `สถานะ ${pr.id} เปลี่ยนเป็น ${newStatus}`, 'success');
    }

    // =========================================================================

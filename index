    function generateReportRows(type, labFilter) {
      const byLab = (itemLab) => labFilter === 'All' || itemLab === labFilter;

      switch (type) {
        case 'Equipment Inventory':
          return STATE.equipments.filter(e => byLab(e.lab)).map(e => ({
            'รหัส': e.equipmentId, 'ชื่ออุปกรณ์': e.name, 'Lab': e.lab, 'ประเภท': e.type,
            'ทั้งหมด': e.total, 'พร้อมใช้': e.available, 'จอง': e.reserved || 0, 'เสีย': e.damaged || 0, 'ขั้นต่ำ': e.minStock
          }));
        case 'Low Stock Report':
          return STATE.equipments.filter(e => byLab(e.lab) && Number(e.available) <= Number(e.minStock)).map(e => ({
            'รหัส': e.equipmentId, 'ชื่ออุปกรณ์': e.name, 'Lab': e.lab, 'คงเหลือ': e.available, 'ขั้นต่ำ': e.minStock, 'สถานะ': 'Low Stock'
          }));
        case 'Damaged Equipment':
          return STATE.equipments.filter(e => byLab(e.lab) && Number(e.damaged || 0) > 0).map(e => ({
            'รหัส': e.equipmentId, 'ชื่ออุปกรณ์': e.name, 'Lab': e.lab, 'จำนวนที่เสีย': e.damaged, 'หน่วย': e.unit
          }));
        case 'Request Report':
          return STATE.requests.filter(r => byLab(r.lab)).map(r => ({
            'Request ID': r.id, 'ครูผู้ขอ': r.teacherName, 'Lab': r.lab, 'การทดลอง': r.experiment, 'วันที่ใช้': r.useDate, 'สถานะ': r.status
          }));
        case 'Stock Movement':
          return STATE.movements.filter(m => byLab(m.lab)).map(m => ({
            'วัน-เวลา': m.date, 'Lab': m.lab, 'อุปกรณ์': m.equipmentName, 'Action': m.action, 'จำนวน': m.qty, 'ผู้บันทึก': m.staff
          }));
        case 'Purchase Report':
          return STATE.purchases.filter(p => byLab(p.lab)).map(p => ({
            'รหัส': p.id, 'อุปกรณ์': p.equipmentName, 'Lab': p.lab, 'จำนวนขอซื้อ': p.qty, 'งบประมาณ': p.price, 'สถานะ': p.status
          }));
        case 'Equipment Usage':
          const usage = [];
          STATE.requests.filter(r => byLab(r.lab)).forEach(r => {
            (r.items || []).forEach(it => usage.push({
              'Request ID': r.id, 'วันที่ใช้': r.useDate, 'Lab': r.lab, 'อุปกรณ์': it.name, 'ขอเบิก': it.requestedQty, 'อนุมัติ': it.approvedQty
            }));
          });
          return usage;
        case 'Unavailable Report':
          const unavail = [];
          STATE.requests.filter(r => byLab(r.lab)).forEach(r => {
            (r.items || []).filter(it => it.approvedQty < it.requestedQty && r.status !== 'Pending').forEach(it => unavail.push({
              'Request ID': r.id, 'Lab': r.lab, 'อุปกรณ์': it.name, 'ขอเบิก': it.requestedQty, 'ได้รับจริง': it.approvedQty, 'ขาดจำนวน': it.requestedQty - it.approvedQty
            }));
          });
          return unavail;
        case 'Teacher Usage Report':
          const tMap = {};
          STATE.requests.filter(r => byLab(r.lab)).forEach(r => {
            tMap[r.teacherName] = (tMap[r.teacherName] || 0) + 1;
          });
          return Object.entries(tMap).map(([teacher, count]) => ({ 'ชื่อครูผู้สอน': teacher, 'จำนวนคำขอทั้งหมด': count }));
        case 'Lab Usage Report':
          return ['Primary', 'Physics', 'Chemistry', 'Biology'].map(l => ({
            'ห้องปฏิบัติการ': l + ' Lab',
            'จำนวนรายการอุปกรณ์': STATE.equipments.filter(e => e.lab === l).length,
            'จำนวนคำขอเบิก': STATE.requests.filter(r => r.lab === l).length
          }));
      }
    }

    function exportReportExcel() {
      const rows = generateReportRows(currentReportType, currentReportLab);
      if (!rows.length) return Swal.fire('ไม่มีข้อมูล', 'ไม่พบข้อมูลสำหรับส่งออก', 'info');
      const ws = XLSX.utils.json_to_sheet(rows);
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, "Report");
      XLSX.writeFile(wb, `IPSLab_${currentReportType.replace(/\s+/g, '_')}.xlsx`);
    }

    function exportReportCSV() {
      const rows = generateReportRows(currentReportType, currentReportLab);
      if (!rows.length) return Swal.fire('ไม่มีข้อมูล', 'ไม่พบข้อมูลสำหรับส่งออก', 'info');
      const ws = XLSX.utils.json_to_sheet(rows);
      const csv = XLSX.utils.sheet_to_csv(ws);
      const blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `IPSLab_${currentReportType.replace(/\s+/g, '_')}.csv`;
      link.click();
    }


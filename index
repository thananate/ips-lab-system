<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>IPS Lab Management System | ระบบเบิก-คืนอุปกรณ์ห้องปฏิบัติการ</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Prompt & Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- SheetJS (Export Excel .xlsx) -->
  <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>

  <!-- Firebase Compat SDKs -->
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Prompt', 'Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    body {
      background: linear-gradient(135deg, #f0f4ff 0%, #f5f3ff 50%, #eef2ff 100%);
      min-height: 100vh;
    }
    .glass-card {
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.7);
      box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.08), 0 8px 10px -6px rgba(79, 70, 229, 0.04);
    }
    .glass-sidebar {
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(16px);
      border-right: 1px solid rgba(226, 232, 240, 0.8);
    }
    @media print {
      .no-print { display: none !important; }
      body { background: white !important; }
      .glass-card { box-shadow: none !important; border: 1px solid #ddd !important; }
    }
  </style>
</head>
<body class="text-slate-800 antialiased">

  <!-- ==================== 1. AUTHENTICATION / LOGIN VIEW ==================== -->
  <div id="authView" class="min-h-screen flex items-center justify-center p-4">
    <div class="glass-card w-full max-w-md rounded-2xl p-8">
      <div class="text-center mb-6">
        <div class="w-14 h-14 bg-gradient-to-tr from-blue-600 to-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg text-white">
          <i data-lucide="flask-conical" class="w-8 h-8"></i>
        </div>
        <h1 class="text-2xl font-bold bg-gradient-to-r from-blue-700 to-purple-700 bg-clip-text text-transparent">IPS Lab System</h1>
        <p class="text-sm text-slate-500 mt-1">ระบบบริหารจัดการและเบิก-คืนอุปกรณ์ห้องปฏิบัติการ</p>
        <div class="mt-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-[11px] font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Firebase Project: ips-lab-system
        </div>
      </div>

      <form id="loginForm" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">อีเมลผู้ใช้งาน (Email)</label>
          <input type="email" id="loginEmail" required placeholder="thepsintopskul.thananate@ips.ac.th" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:outline-none text-sm bg-white" />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">รหัสผ่าน (Password)</label>
          <input type="password" id="loginPassword" required placeholder="••••••••" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:outline-none text-sm bg-white" />
        </div>
        <button type="submit" id="loginSubmitBtn" class="w-full py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-purple-600 text-white font-medium text-sm hover:opacity-95 transition shadow-md">
          เข้าสู่ระบบ
        </button>
      </form>

      <div class="mt-5 pt-4 border-t border-slate-100 text-center">
        <p class="text-[11px] text-slate-400">
          จัดการบัญชีผู้ใช้งานผ่าน Firebase Authentication<br>
          และกำหนดสิทธิ์ใน Cloud Firestore (Collection: <code class="text-indigo-600">user</code>)
        </p>
      </div>
    </div>
  </div>

  <!-- ==================== 2. MAIN SPA SHELL ==================== -->
  <div id="appShell" class="hidden min-h-screen flex flex-col lg:flex-row">
    
    <!-- Sidebar Navigation -->
    <aside class="glass-sidebar w-full lg:w-64 flex-shrink-0 flex flex-col justify-between no-print">
      <div>
        <div class="p-5 flex items-center justify-between border-b border-slate-100">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-gradient-to-tr from-blue-600 to-purple-600 rounded-xl flex items-center justify-center text-white shadow">
              <i data-lucide="flask-conical" class="w-5 h-5"></i>
            </div>
            <div>
              <div class="font-bold text-slate-800 leading-tight">IPS Lab</div>
              <div class="text-[11px] text-emerald-600 font-medium">● Firebase Live Sync</div>
            </div>
          </div>
          <button id="mobileMenuBtn" class="lg:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100">
            <i data-lucide="menu" class="w-5 h-5"></i>
          </button>
        </div>

        <nav id="sidebarNav" class="hidden lg:block p-4 space-y-1.5"></nav>
      </div>

      <!-- User Profile Footer -->
      <div class="p-4 border-t border-slate-100 hidden lg:block">
        <div class="bg-slate-50 rounded-xl p-3 mb-3">
          <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center text-sm" id="userAvatar">U</div>
            <div class="overflow-hidden">
              <div class="text-xs font-semibold text-slate-800 truncate" id="userNameDisplay">-</div>
              <div class="text-[11px] text-indigo-600 font-medium" id="userRoleDisplay">-</div>
              <div class="text-[10px] text-slate-400 truncate" id="userLabDisplay">-</div>
            </div>
          </div>
        </div>
        <button onclick="logout()" class="w-full flex items-center justify-center gap-2 py-2 px-3 rounded-xl text-xs font-medium text-rose-600 bg-rose-50 hover:bg-rose-100 transition">
          <i data-lucide="log-out" class="w-4 h-4"></i> ออกจากระบบ
        </button>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 p-4 md:p-6 lg:p-8 overflow-y-auto">
      <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 no-print">
        <div>
          <h2 id="pageTitle" class="text-xl md:text-2xl font-bold text-slate-800">ภาพรวมระบบ (Dashboard)</h2>
          <p id="pageSubtitle" class="text-xs md:text-sm text-slate-500">ยินดีต้อนรับสู่ระบบบริหารจัดการอุปกรณ์วิทยาศาสตร์ IPS Lab</p>
        </div>
        <div class="flex items-center gap-2">
          <div class="relative">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-2.5"></i>
            <input type="text" id="globalSearchInput" onkeyup="handleGlobalSearch(this.value)" placeholder="ค้นหาอุปกรณ์, รหัสคำขอ, ครู..." class="pl-9 pr-4 py-2 rounded-xl border border-slate-200 bg-white text-xs focus:ring-2 focus:ring-indigo-500 focus:outline-none w-56 md:w-64" />
          </div>
          <button onclick="logout()" class="lg:hidden p-2 rounded-xl bg-rose-50 text-rose-600">
            <i data-lucide="log-out" class="w-4 h-4"></i>
          </button>
        </div>
      </header>

      <div id="pageContainer" class="space-y-6"></div>
    </main>
  </div>

  <!-- ==================== MODALS ==================== -->
  <!-- Equipment Modal -->
  <div id="equipmentModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <h3 id="eqModalTitle" class="text-lg font-bold text-slate-800">เพิ่มรายการอุปกรณ์ใหม่</h3>
        <button onclick="closeModal('equipmentModal')" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <form id="equipmentForm" class="mt-4 space-y-4">
        <input type="hidden" id="eqDocId" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">รหัสอุปกรณ์ (Equipment ID) *</label>
            <input type="text" id="eqId" required placeholder="เช่น PHY-001" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">ชื่ออุปกรณ์ (Equipment Name) *</label>
            <input type="text" id="eqName" required placeholder="เช่น Beaker 250 ml" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">ห้องปฏิบัติการ (Lab) *</label>
            <select id="eqLab" required class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm">
              <option value="Primary">Primary Lab</option>
              <option value="Physics">Physics Lab (ฟิสิกส์)</option>
              <option value="Chemistry">Chemistry Lab (เคมี)</option>
              <option value="Biology">Biology Lab (ไบโอ)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">ประเภทอุปกรณ์ (Equipment Type) *</label>
            <select id="eqType" required class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm">
              <option value="Reusable">Reusable (เครื่องแก้ว/รับคืน)</option>
              <option value="Equipment">Equipment (เครื่องมือ/จองและคืน)</option>
              <option value="Consumable">Consumable (วัสดุสิ้นเปลือง/ตัด Stock)</option>
              <option value="Chemical">Chemical (สารเคมี/ควบคุมความปลอดภัย)</option>
              <option value="Set / Kit">Set / Kit (ชุดการทดลอง)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">หมวดหมู่ย่อย (Category)</label>
            <input type="text" id="eqCategory" placeholder="เช่น เครื่องแก้ว, กล้องจุลทรรศน์" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">ขนาด / รายละเอียด (Specification)</label>
            <input type="text" id="eqSpec" placeholder="เช่น Borosilicate Glass 250ml" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">หน่วยนับ (Unit) *</label>
            <input type="text" id="eqUnit" required placeholder="เช่น ใบ, เครื่อง, กล่อง, ขวด" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">ตำแหน่งจัดเก็บ (Storage Location)</label>
            <input type="text" id="eqLocation" placeholder="เช่น ตู้ A ชั้น 2" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">จำนวนทั้งหมด (Total Stock) *</label>
            <input type="number" id="eqTotal" min="0" required class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">จำนวนขั้นต่ำแจ้งเตือน (Minimum Stock) *</label>
            <input type="number" id="eqMin" min="0" required class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">สถานะ (Status)</label>
            <select id="eqStatus" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm">
              <option value="Active">Active</option>
              <option value="Inactive">Inactive</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">รูปภาพอุปกรณ์ (บีบอัด Canvas Base64)</label>
            <input type="file" id="eqImageInput" accept="image/*" onchange="handleImageUpload(event)" class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:text-indigo-700" />
            <input type="hidden" id="eqImageBase64" />
            <img id="eqImagePreview" class="mt-2 h-16 w-16 object-cover rounded-lg hidden border" />
          </div>
        </div>
        <div class="flex justify-end gap-2 pt-4 border-t border-slate-100">
          <button type="button" onclick="closeModal('equipmentModal')" class="px-4 py-2 rounded-xl text-sm text-slate-600 hover:bg-slate-100">ยกเลิก</button>
          <button type="submit" class="px-5 py-2 rounded-xl text-sm font-medium bg-indigo-600 text-white hover:bg-indigo-700">บันทึกข้อมูลอุปกรณ์</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Stock Movement Modal -->
  <div id="stockModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl w-full max-w-lg p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <h3 class="text-lg font-bold text-slate-800">บันทึกการปรับยอด Stock (Audit Log)</h3>
        <button onclick="closeModal('stockModal')" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <form id="stockForm" class="mt-4 space-y-4">
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">เลือกอุปกรณ์ *</label>
          <select id="stkEqSelect" required class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm"></select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">ประเภทรายการ (Action) *</label>
            <select id="stkAction" onchange="toggleTransferLab(this.value)" required class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm">
              <option value="Stock In">Stock In (+ เพิ่มอุปกรณ์ใหม่)</option>
              <option value="Stock Out">Stock Out (- นำอุปกรณ์ออก)</option>
              <option value="Returned">Returned (+ รับคืนอุปกรณ์)</option>
              <option value="Damaged">Damaged (- แจ้งอุปกรณ์เสีย)</option>
              <option value="Lost">Lost (- แจ้งอุปกรณ์สูญหาย)</option>
              <option value="Stock Adjustment">Stock Adjustment (ปรับยอดตรวจนับ)</option>
              <option value="Transferred">Transferred (ย้ายข้าม Lab)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">จำนวน (Qty) *</label>
            <input type="number" id="stkQty" min="1" required class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm" />
          </div>
        </div>
        <div id="transferTargetDiv" class="hidden">
          <label class="block text-xs font-medium text-slate-600 mb-1">ย้ายไปยัง Lab ปลายทาง *</label>
          <select id="stkTargetLab" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm">
            <option value="Primary">Primary Lab</option>
            <option value="Physics">Physics Lab</option>
            <option value="Chemistry">Chemistry Lab</option>
            <option value="Biology">Biology Lab</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">หมายเหตุ / อ้างอิง (Remarks) *</label>
          <input type="text" id="stkNote" required placeholder="เช่น รับเข้าจากใบสั่งซื้อ PO-2026-01 หรือ แตกหักระหว่างการทดลอง" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm" />
        </div>
        <div class="flex justify-end gap-2 pt-4 border-t border-slate-100">
          <button type="button" onclick="closeModal('stockModal')" class="px-4 py-2 rounded-xl text-sm text-slate-600 hover:bg-slate-100">ยกเลิก</button>
          <button type="submit" class="px-5 py-2 rounded-xl text-sm font-medium bg-indigo-600 text-white hover:bg-indigo-700">ยืนยันและบันทึกประวัติ</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Staff Approval Modal (Item-by-Item) -->
  <div id="approvalModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl w-full max-w-3xl max-h-[90vh] overflow-y-auto p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <div>
          <h3 class="text-lg font-bold text-slate-800">ตรวจสอบและอนุมัติคำขอเบิกอุปกรณ์</h3>
          <p id="appModalMeta" class="text-xs text-slate-500 mt-0.5"></p>
        </div>
        <button onclick="closeModal('approvalModal')" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <div id="approvalItemsContainer" class="mt-4 space-y-3"></div>
      <div class="mt-4">
        <label class="block text-xs font-medium text-slate-600 mb-1">หมายเหตุจากเจ้าหน้าที่ (Staff Remarks)</label>
        <input type="text" id="appStaffRemarks" placeholder="ระบุข้อความถึงครูผู้ขอเบิก หรือคำแนะนำอุปกรณ์ทดแทน..." class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm" />
      </div>
      <div class="flex flex-wrap items-center justify-between gap-2 pt-4 mt-4 border-t border-slate-100">
        <div class="text-[11px] text-slate-400">ระบบจะบันทึกชื่อเจ้าหน้าที่และวันเวลาอนุมัติอัตโนมัติ</div>
        <div class="flex gap-2">
          <button type="button" onclick="closeModal('approvalModal')" class="px-4 py-2 rounded-xl text-sm text-slate-600 hover:bg-slate-100">ปิด</button>
          <button type="button" onclick="submitStaffApproval()" class="px-5 py-2 rounded-xl text-sm font-medium bg-emerald-600 text-white hover:bg-emerald-700 shadow">บันทึกผลการอนุมัติ</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Purchase Request Modal -->
  <div id="purchaseModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl w-full max-w-lg p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <h3 class="text-lg font-bold text-slate-800">สร้างคำขอจัดซื้ออุปกรณ์ (Purchase Request)</h3>
        <button onclick="closeModal('purchaseModal')" class="text-slate-400 hover:text-slate-600"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>
      <form id="purchaseForm" class="mt-4 space-y-3">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">ชื่ออุปกรณ์ *</label>
            <input type="text" id="prEqName" required class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">ห้องปฏิบัติการ (Lab) *</label>
            <select id="prLab" required class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm">
              <option value="Primary">Primary</option>
              <option value="Physics">Physics</option>
              <option value="Chemistry">Chemistry</option>
              <option value="Biology">Biology</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">จำนวนที่ขอจัดซื้อ *</label>
            <input type="number" id="prQty" min="1" required class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">หน่วยนับ *</label>

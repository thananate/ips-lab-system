      e.preventDefault();
      await db.collection('purchases').add({
        id: 'PR-' + String(STATE.purchases.length + 1).padStart(3, '0'),
        equipmentName: document.getElementById('prEqName').value.trim(),
        lab: document.getElementById('prLab').value,
        qty: Number(document.getElementById('prQty').value),

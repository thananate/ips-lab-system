              <button onclick="exportReportExcel()" class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-emerald-600 text-white text-xs font-medium hover:bg-emerald-700">
                <i data-lucide="file-spreadsheet" class="w-4 h-4"></i> Export Excel (.xlsx)
              </button>
              <button onclick="exportReportCSV()" class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-blue-600 text-white text-xs font-medium hover:bg-blue-700">

    function cancelRequest(docId) {
      const req = STATE.requests.find(r => r.docId === docId);
      if (req.status !== 'Pending') {
        return Swal.fire('ไม่สามารถยกเลิกได้', 'เจ้าหน้าที่ได้ดำเนินการเตรียมอุปกรณ์แล้ว กรุณาติดต่อเจ้าหน้าที่ Lab', 'warning');
      }
      Swal.fire({
        title: 'ยืนยันการยกเลิกคำขอ?',
        text: `คำขอ ${req.id} จะถูกยกเลิกและบันทึกประวัติผู้ยกเลิก`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'ยืนยันยกเลิก',
        cancelButtonText: 'ปิด'
      }).then(async res => {
        if (res.isConfirmed) {
          await db.collection('requests').doc(docId).update({
            status: 'Cancelled',
            approvedBy: `ยกเลิกโดย ${STATE.currentUser.name}`,
            approvalDate: new Date().toISOString().slice(0, 16).replace('T', ' ')
          });
          Swal.fire('ยกเลิกสำเร็จ', 'ยกเลิกคำขอเรียบร้อยแล้ว', 'success');
        }
      });
    }

    async function markRequestReturned(docId) {
      const req = STATE.requests.find(r => r.docId === docId);
      for (const it of (req.items || [])) {
        if (it.approvedQty > 0 && it.type !== 'Consumable' && it.type !== 'Chemical') {
          const eq = STATE.equipments.find(e => e.id === it.eqDocId);
          if (eq) {
            await db.collection('equipments').doc(eq.id).update({
              reserved: Math.max(0, Number(eq.reserved || 0) - Number(it.approvedQty)),
              available: Math.min(Number(eq.total) - Number(eq.damaged || 0), Number(eq.available) + Number(it.approvedQty))
            });
            await addStockMovement(eq.equipmentId, eq.name, eq.lab, 'Returned', it.approvedQty, `รับคืนอุปกรณ์จากคำขอ ${req.id}`);
          }
        }
      }
      await db.collection('requests').doc(docId).update({ status: 'Returned' });
      Swal.fire('รับคืนสำเร็จ', 'คืนยอดอุปกรณ์กลับเข้าสู่คลังพร้อมใช้งานแล้ว', 'success');
    }


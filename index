    function updateAvailableEquipmentDropdown() {
      const lab = document.getElementById('reqLab').value;
      const date = document.getElementById('reqDate').value;
      const start = document.getElementById('reqStart').value;
      const end = document.getElementById('reqEnd').value;

      const options = STATE.equipments
        .filter(e => e.lab === lab && e.status === 'Active')
        .map(e => {
          const slotAvail = getAvailableForTimeSlot(e.id, date, start, end);
          return `<option value="${e.id}">${e.name} (${e.type}) — ว่างช่วงเวลานี้: ${slotAvail} ${e.unit}</option>`;
        }).join('');
      document.getElementById('reqEqDropdown').innerHTML = options || '<option value="">ไม่มีอุปกรณ์ใน Lab นี้</option>';
    }

    function addDraftItem() {
      const eqDocId = document.getElementById('reqEqDropdown').value;
      const qty = Number(document.getElementById('reqEqQty').value);
      const date = document.getElementById('reqDate').value;
      const start = document.getElementById('reqStart').value;
      const end = document.getElementById('reqEnd').value;

      if (!eqDocId || qty <= 0) return;
      const eq = STATE.equipments.find(e => e.id === eqDocId);
      const slotAvail = getAvailableForTimeSlot(eqDocId, date, start, end);

      if (qty > slotAvail) {
        return Swal.fire('จำนวนเกินกว่าที่ว่างในช่วงเวลานี้', `อุปกรณ์ ${eq.name} มีจำนวนว่างในช่วง ${start}-${end} เพียง ${slotAvail} ${eq.unit}`, 'warning');
      }

      const existing = draftRequestItems.find(i => i.eqDocId === eqDocId);
      if (existing) {
        if (existing.requestedQty + qty > slotAvail) return Swal.fire('เกินจำนวนว่าง', 'ยอดรวมเกินจำนวนที่ว่างในช่วงเวลานี้', 'warning');
        existing.requestedQty += qty;
      } else {
        draftRequestItems.push({
          eqDocId: eq.id,
          equipmentId: eq.equipmentId,
          name: eq.name,
          type: eq.type,
          requestedQty: qty,
          approvedQty: 0,
          itemStatus: 'Pending',
          alternativeNote: ''
        });
      }
      renderDraftItems();
    }

    function renderDraftItems() {
      const box = document.getElementById('draftItemsList');
      if (!box) return;
      if (draftRequestItems.length === 0) {
        box.innerHTML = `<p class="text-xs text-slate-400 text-center py-4">ยังไม่ได้เพิ่มรายการอุปกรณ์</p>`;
        return;
      }
      box.innerHTML = draftRequestItems.map((item, idx) => `
        <div class="flex items-center justify-between p-3 rounded-xl bg-white border border-slate-200 text-xs">
          <div>
            <span class="font-bold text-slate-800">${item.name}</span>
            <span class="text-[11px] text-slate-400 ml-2">(${item.type})</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="font-semibold text-indigo-600">จำนวน: ${item.requestedQty}</span>
            <button onclick="draftRequestItems.splice(${idx}, 1); renderDraftItems();" class="text-rose-500 hover:underline">ลบ</button>
          </div>
        </div>
      `).join('');
    }

    async function submitNewRequest() {
      const lab = document.getElementById('reqLab').value;
      const experiment = document.getElementById('reqExperiment').value.trim();
      const useDate = document.getElementById('reqDate').value;
      const startTime = document.getElementById('reqStart').value;
      const endTime = document.getElementById('reqEnd').value;

      if (!experiment || !useDate || !startTime || !endTime || draftRequestItems.length === 0) {
        return Swal.fire('ข้อมูลไม่ครบถ้วน', 'กรุณากรอกชื่อการทดลอง วันเวลา และเพิ่มอุปกรณ์อย่างน้อย 1 รายการ', 'warning');
      }
      if (startTime >= endTime) {
        return Swal.fire('ช่วงเวลาไม่ถูกต้อง', 'เวลาสิ้นสุดต้องมากกว่าเวลาเริ่มต้น', 'warning');
      }

      const reqId = 'LAB-' + String(STATE.requests.length + 1).padStart(3, '0');
      const newReq = {
        id: reqId,
        teacherName: STATE.currentUser.name,
        teacherEmail: STATE.currentUser.email,
        lab,
        experiment,
        useDate,
        startTime,
        endTime,
        status: 'Pending',
        createdAt: new Date().toISOString().slice(0, 16).replace('T', ' '),
        approvedBy: '',
        approvalDate: '',
        staffRemarks: '',
        items: JSON.parse(JSON.stringify(draftRequestItems))
      };

      await db.collection('requests').add(newReq);
      draftRequestItems = [];
      Swal.fire('ส่งคำขอสำเร็จ', `รหัสคำขอของคุณคือ ${reqId}`, 'success');
      navigateTo('my-requests');
    }


          refreshUI();
        }),
        db.collection('requests').onSnapshot(snap => {
          STATE.requests = snap.docs.map(d => ({ docId: d.id, ...d.data() }));
          refreshUI();
        }),
        db.collection('movements').orderBy('timestamp', 'asc').onSnapshot(snap => {
          STATE.movements = snap.docs.map(d => ({ id: d.id, ...d.data() }));
          refreshUI();
        }),
        db.collection('purchases').onSnapshot(snap => {
          STATE.purchases = snap.docs.map(d => ({ docId: d.id, ...d.data() }));
          refreshUI();
        }),
        db.collection('user').onSnapshot(snap => {
          STATE.users = snap.docs.map(d => ({ uid: d.id, ...d.data() }));
          refreshUI();
        })

    document.getElementById('stockForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const eqId = document.getElementById('stkEqSelect').value;
      const action = document.getElementById('stkAction').value;
      const qty = Number(document.getElementById('stkQty').value);
      const note = document.getElementById('stkNote').value.trim();
      const eq = STATE.equipments.find(item => item.id === eqId);
      if (!eq) return;

      let signedQty = qty;
      let updateFields = {};

      if (action === 'Stock In') {
        updateFields = { total: Number(eq.total) + qty, available: Number(eq.available) + qty };
      } else if (action === 'Returned') {
        updateFields = {
          available: Math.min(Number(eq.total) - Number(eq.damaged || 0), Number(eq.available) + qty),
          reserved: Math.max(0, Number(eq.reserved || 0) - qty)
        };
      } else if (action === 'Stock Out') {
        if (Number(eq.available) < qty) return Swal.fire('ยอดคงเหลือไม่พอ', 'จำนวนพร้อมใช้งานไม่เพียงพอ', 'error');
        updateFields = { total: Number(eq.total) - qty, available: Number(eq.available) - qty };
        signedQty = -qty;
      } else if (action === 'Damaged') {
        if (Number(eq.available) < qty) return Swal.fire('ยอดคงเหลือไม่พอ', 'จำนวนพร้อมใช้งานไม่เพียงพอ', 'error');
        updateFields = { available: Number(eq.available) - qty, damaged: Number(eq.damaged || 0) + qty };
        signedQty = -qty;
      } else if (action === 'Lost') {
        if (Number(eq.available) < qty) return Swal.fire('ยอดคงเหลือไม่พอ', 'จำนวนพร้อมใช้งานไม่เพียงพอ', 'error');
        updateFields = { total: Number(eq.total) - qty, available: Number(eq.available) - qty };
        signedQty = -qty;
      } else if (action === 'Stock Adjustment') {
        updateFields = { total: Number(eq.total) + qty, available: Number(eq.available) + qty };
      } else if (action === 'Transferred') {
        const targetLab = document.getElementById('stkTargetLab').value;
        if (targetLab === eq.lab) return Swal.fire('ผิดพลาด', 'กรุณาเลือก Lab ปลายทางที่ต่างจากต้นทาง', 'warning');
        if (Number(eq.available) < qty) return Swal.fire('ยอดคงเหลือไม่พอ', 'จำนวนพร้อมใช้งานไม่เพียงพอสำหรับโอนย้าย', 'error');
        updateFields = { total: Number(eq.total) - qty, available: Number(eq.available) - qty };
        signedQty = -qty;

        const destEq = STATE.equipments.find(x => x.name === eq.name && x.lab === targetLab);
        if (destEq) {
          await db.collection('equipments').doc(destEq.id).update({
            total: Number(destEq.total) + qty,
            available: Number(destEq.available) + qty
          });
          await addStockMovement(destEq.equipmentId, destEq.name, targetLab, 'Stock In', qty, `รับโอนย้ายจาก ${eq.lab} Lab (${note})`);
        } else {
          const newCode = targetLab.substring(0, 3).toUpperCase() + '-' + Math.floor(100 + Math.random() * 900);
          await db.collection('equipments').add({
            equipmentId: newCode,
            name: eq.name,
            lab: targetLab,
            type: eq.type,
            category: eq.category || '',
            spec: eq.spec || '',
            unit: eq.unit,
            location: 'จุดรับโอนย้าย',
            total: qty,
            available: qty,
            reserved: 0,
            damaged: 0,
            minStock: eq.minStock || 5,
            status: 'Active',
            image: eq.image || ''
          });
          await addStockMovement(newCode, eq.name, targetLab, 'Stock In', qty, `รับโอนย้ายจาก ${eq.lab} Lab (${note})`);
        }
      }

      await db.collection('equipments').doc(eq.id).update(updateFields);
      await addStockMovement(eq.equipmentId, eq.name, eq.lab, action, signedQty, note);
      closeModal('stockModal');
      Swal.fire('บันทึกสำเร็จ', 'ปรับปรุงยอด Stock และบันทึกประวัติเรียบร้อยแล้ว', 'success');
    });

    async function addStockMovement(equipmentId, equipmentName, lab, action, qty, note) {
      const now = new Date().toISOString().slice(0, 16).replace('T', ' ');
      await db.collection('movements').add({
        timestamp: Date.now(),
        date: now,
        equipmentId,
        equipmentName,
        lab,
        action,
        qty,
        staff: STATE.currentUser ? STATE.currentUser.name : 'System',
        note
      });
    }


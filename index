        if (user[l] === true || user[l] === 'true' || user[l] === 'Yes' || user[l] === '1' || user.assignedLab === l) {
          labs.push(l);
        }
      });
      return labs.length > 0 ? labs : ['Primary', 'Physics', 'Chemistry', 'Biology'];
